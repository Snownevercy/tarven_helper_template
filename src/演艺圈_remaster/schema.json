{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "世界": {
      "type": "object",
      "properties": {
        "当前日期": {
          "default": "待定",
          "type": "string"
        },
        "当前地点": {
          "default": "待定",
          "type": "string"
        },
        "时代新闻": {
          "default": "待定",
          "type": "string"
        },
        "行业新闻": {
          "default": "待定",
          "type": "string"
        },
        "八卦新闻": {
          "default": "待定",
          "type": "string"
        }
      }
    },
    "主角": {
      "type": "object",
      "properties": {
        "姓名": {
          "default": "待定",
          "type": "string"
        },
        "性别": {
          "default": "待定",
          "type": "string"
        },
        "国籍": {
          "default": "待定",
          "type": "string"
        },
        "生日": {
          "default": "待定",
          "type": "string"
        },
        "_年龄": {
          "type": "number"
        },
        "外貌": {
          "default": "待定",
          "type": "string"
        },
        "职业": {
          "default": "待定",
          "type": "string"
        },
        "性癖": {
          "default": "无",
          "type": "string"
        }
      }
    },
    "职业履历": {
      "type": "object",
      "properties": {
        "作品名": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "获取奖项": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "专业评估": {
      "type": "object",
      "properties": {
        "当前咖位": {
          "default": "无",
          "type": "string"
        },
        "业务能力": {
          "default": "无",
          "type": "string"
        },
        "媒体风向": {
          "default": "无",
          "type": "string"
        },
        "社会风评": {
          "default": "无",
          "type": "string"
        },
        "粉丝基础": {
          "default": "无",
          "type": "string"
        }
      }
    },
    "个人账户": {
      "default": {},
      "type": "object",
      "properties": {
        "月度固定收入": {
          "description": "每月固定收入总和：工资、租金收入、投资分红等",
          "$ref": "#/$defs/__schema0"
        },
        "月度固定支出": {
          "description": "每月固定支出总和：房租、贷款月供、生活费等",
          "$ref": "#/$defs/__schema1"
        },
        "私账一次性变动": {
          "description": "本轮一次性收支净变动（正数=收入，负数=支出）",
          "$ref": "#/$defs/__schema2"
        },
        "合约状态": {
          "default": "无",
          "type": "string"
        },
        "持有资产": {
          "description": "格式：资产描述@数量@购入总价（人民币）",
          "default": {},
          "$ref": "#/$defs/__schema3"
        },
        "_现金": {
          "type": "number"
        }
      }
    },
    "公司账户": {
      "default": {},
      "type": "object",
      "properties": {
        "月度收入来源": {
          "description": "公司每月经营性收入的来源；key 为业务线类型，同类型子产品/活动合并到同一条",
          "default": {},
          "$ref": "#/$defs/__schema4"
        },
        "月度固定支出": {
          "default": {},
          "type": "object",
          "properties": {
            "人力": {
              "description": "Monthly fixed payroll and staff-related costs (operating expenses: mainly R&D / S&M / G&A).",
              "$ref": "#/$defs/__schema10"
            },
            "场地成本": {
              "description": "Office / studio rent and facility utilities (operating expenses: usually classified as G&A).",
              "$ref": "#/$defs/__schema11"
            },
            "营销预算": {
              "description": "每月固定营销支出（广告、推广等）；大型一次性活动走公账一次性变动",
              "$ref": "#/$defs/__schema12"
            },
            "其他": {
              "description": "每月其他固定支出（软件订阅、设备折旧、保险等）",
              "$ref": "#/$defs/__schema13"
            }
          }
        },
        "公账一次性变动": {
          "description": "本轮非经营性资金流动（正数=收入，负数=支出）",
          "$ref": "#/$defs/__schema14"
        },
        "_现金": {
          "type": "number"
        }
      }
    },
    "人脉": {
      "type": "object",
      "properties": {
        "社交版图": {
          "default": [
            "无"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "近期互动": {
          "default": [
            "无"
          ],
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema15"
          },
          "description": "最近有过关键交互的人"
        },
        "关系簿": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "蝴蝶效应": {
      "type": "object",
      "properties": {
        "已抹除列表": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "description": "原作者"
          }
        }
      }
    }
  },
  "required": [
    "世界",
    "主角",
    "职业履历",
    "专业评估",
    "人脉",
    "蝴蝶效应"
  ],
  "$defs": {
    "__schema0": {
      "type": "number"
    },
    "__schema1": {
      "type": "number"
    },
    "__schema2": {
      "type": "number"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "房产": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "车辆": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "股票": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "__schema4": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "业务线类型名"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "_业务范围": {
            "description": "该业务线涵盖的范围与定义（简短文本，用于判断新业务是否归入本条）",
            "default": "待定",
            "$ref": "#/$defs/__schema5"
          },
          "月销量": {
            "description": "规模指标(volume)：按量计费=本月销量；订阅=本月活跃/付费用户数(user base)",
            "$ref": "#/$defs/__schema6"
          },
          "单价": {
            "description": "单位收益(unit value)：按量计费=每次/每件平均收入；订阅=每用户每月平均收入(ARPU)",
            "$ref": "#/$defs/__schema7"
          },
          "可变成本率": {
            "description": "每单位销售的可变成本占比，0.0~1.0",
            "default": 0.3,
            "$ref": "#/$defs/__schema8"
          },
          "_月毛利": {
            "description": "由脚本计算：月销量 * 单价 * (1 - 可变成本率)",
            "$ref": "#/$defs/__schema9"
          }
        }
      }
    },
    "__schema5": {
      "type": "string"
    },
    "__schema6": {
      "type": "number"
    },
    "__schema7": {
      "type": "number"
    },
    "__schema8": {
      "type": "number"
    },
    "__schema9": {
      "type": "number"
    },
    "__schema10": {
      "type": "number"
    },
    "__schema11": {
      "type": "number"
    },
    "__schema12": {
      "type": "number"
    },
    "__schema13": {
      "type": "number"
    },
    "__schema14": {
      "type": "number"
    },
    "__schema15": {
      "type": "string"
    }
  }
}